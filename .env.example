# Copy to .env  (never commit .env)
# --- Answer generation (optional). Without a key Aahar.AI quotes passages from its sources (offline mode).
# AAHAR_LLM_PROVIDER=auto            # auto | openai | anthropic | none
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# --- Retrieval
# AAHAR_DENSE_MODEL=BAAI/bge-small-en-v1.5   # needs: pip install sentence-transformers
# AAHAR_TOP_K=5
# AAHAR_MIN_CONFIDENCE=0.35                  # below this the bot refuses instead of guessing
# --- App
# AAHAR_DB=./aahar.db
# AAHAR_EMERGENCY_NUMBER=112 / 999
